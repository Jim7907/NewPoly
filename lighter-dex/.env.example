# Lighter network: "mainnet" or "testnet" (testnet = fake funds, use it first!)
VITE_LIGHTER_NETWORK=testnet

# Which API key slot this frontend registers on the user's Lighter account (2-254).
# Slots 0 and 1 are used by Lighter's own web/mobile apps — don't use those.
VITE_API_KEY_INDEX=7

# Optional: WalletConnect Cloud project id (https://cloud.reown.com) to support mobile wallets.
# Without it, only browser-extension wallets (MetaMask, Rabby, ...) are offered.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: earn a fee on trades routed through your frontend (Lighter "integrator" fees).
# Your own Lighter account index that collects the fees:
VITE_INTEGRATOR_ACCOUNT_INDEX=
# Fees in millionths of notional: 100 = 0.01%, 1000 = 0.1%. Integrator mode is only
# active when the account index is set AND at least one fee is > 0. Users approve once
# (wallet signature) before their first order.
VITE_INTEGRATOR_TAKER_FEE=0
VITE_INTEGRATOR_MAKER_FEE=0
