# Non-Docker deployment. Install:
#   sudo cp barometer/systemd/barometer.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now barometer
# Adjust User/WorkingDirectory to match where you cloned the repo. Keys live in barometer/.env.
[Unit]
Description=Barometer — VeSync signal-driven advertising platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/NewPoly/barometer
EnvironmentFile=-/root/NewPoly/barometer/.env
Environment=NODE_ENV=production
Environment=PORT=3003
Environment=DB_PATH=/root/NewPoly/barometer/data
ExecStartPre=/usr/bin/env bash -lc 'cd /root/NewPoly/barometer && npm install && npm run build'
ExecStart=/usr/bin/env node server/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
