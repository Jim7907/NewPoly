# ---- server ----
PORT=3004
DB_PATH=./data
# Barometer never writes to an ad account unless LIVE_WRITES=true AND that channel has credentials.
LIVE_WRITES=false

# ---- creative generation (optional; template creatives are used without it) ----
ANTHROPIC_API_KEY=
BAROMETER_MODEL=claude-opus-5

# ---- feeds that need a key (all free to register). Leave blank to skip the feed. ----
AIRNOW_API_KEY=           # https://docs.airnowapi.org
PURPLEAIR_API_KEY=        # https://develop.purpleair.com
FIRMS_MAP_KEY=            # https://firms.modaps.eosdis.nasa.gov/api/map_key
GOOGLE_MAPS_API_KEY=      # Air Quality + Pollen APIs
EIA_API_KEY=              # https://www.eia.gov/opendata/register.php
BLS_API_KEY=              # optional; raises the daily quota

# ---- ad platforms (all optional; adapters run in dry-run without them) ----
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
AMAZON_DSP_ADVERTISER_ID=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
WALMART_CONNECT_TOKEN=
KLAVIYO_API_KEY=
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
APP_PUSH_WEBHOOK=

# ---- first-party device feed (left open — see README "First-party adapter") ----
FIRSTPARTY_INGEST_TOKEN=change-me
