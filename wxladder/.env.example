# ── Server ───────────────────────────────────────────────
PORT=3003
NODE_ENV=development
DB_PATH=./data
SCAN_MS=120000          # daily markets; a 2-minute loop is plenty
WX_TTL_MIN=45           # forecast cache TTL (model runs land every 6-12 h)

# ── Universe ─────────────────────────────────────────────
# Blank CITIES = every METAR-resolved station in server/config.js (32 of them).
# Narrow it to cut API load, e.g. CITIES=Singapore,Tokyo,Taipei,Manila
CITIES=
KINDS=high,low

# ── Horizon ──────────────────────────────────────────────
# Polymarket lists today (D+0) and tomorrow (D+1) only, so D+1 is where this actually runs.
MIN_LEAD_DAYS=1
MAX_LEAD_DAYS=2

# ── Forecast model ───────────────────────────────────────
ENS_MODELS=ecmwf_ifs025,gfs025,icon_seamless
DET_MODELS=ecmwf_ifs025,gfs_seamless,icon_seamless,jma_seamless
W_DET=0.65              # centre = W_DET*deterministic + (1-W_DET)*ensemble mean
SPREAD_GAMMA=0.5        # how far today's ensemble spread moves sigma (0=climo, 1=full)
SD_FLOOR=0.6            # deg C — representativeness floor on the predictive sigma
SD_FALLBACK=1.6         # deg C — sigma before any error history exists
SIGMA_MULT=1.0          # post-hoc sigma calibration; `npm run backtest` fits this
EMPIRICAL_W=0           # weight on the raw member histogram (ships OFF, backtest may enable)

# ── Model vs market ──────────────────────────────────────
W_MODEL=0.6             # P_used = W_MODEL*P_model + (1-W_MODEL)*P_market (de-vigged)
MAX_TVD=0.55            # model/market disagreement above this is a broken model, not an edge
MAX_SANE_EV=1.5         # a basket implying +150%/$ is a bug; refuse it

# ── Bias correction (the single highest-value component) ──
BIAS_WINDOW_DAYS=30
BIAS_HALFLIFE_DAYS=10
MIN_BIAS_SAMPLES=8      # refuse to trade a station until it is calibrated
BIAS_CLAMP=4.0          # deg C — never shift the centre further than this

# ── Underdispersion filter ───────────────────────────────
UNDERDISP_LO=0.85       # today's spread / station median below this = tight, press
OVERDISP_HI=1.25        # above this = wide, widen the ladder or sit out
TIGHT_BUDGET_MULT=1.5
WIDE_BUDGET_MULT=0.5
SKIP_WHEN_WIDE=false
MIN_DISP_SAMPLES=10     # live spread history needed before the filter activates

# ── Ladder shape ─────────────────────────────────────────
LADDER_MIN_W=3
LADDER_MAX_W=4
MAX_BASKET_COST=0.85    # measured break-even for a 3-rung cluster; see the backtest
MIN_BASKET_EV=0.08      # min EV per $1 of basket cost, after fees
MIN_COVER_PROB=0.70     # model P(outcome lands inside the cluster)

# ── Costs ────────────────────────────────────────────────
# Live weather markets return feeSchedule {exponent:1, rate:0.05, takerOnly:true}:
# fee/share = rate*min(q,1-q) — a flat ~5% of stake for any rung priced under 0.50.
FEE_RATE=0.05
FEE_EXP=1
USE_MARKET_FEE_SCHEDULE=true
SLIP=0.002

# ── Liquidity gates ──────────────────────────────────────
MAX_LEG_SPREAD_C=6
MIN_LEG_DEPTH_USD=20
MIN_ORDER_SHARES=5      # Polymarket orderMinSize on these markets

# ── Sizing ───────────────────────────────────────────────
SIZING=kelly            # kelly | prob | equal
PAPER_BALANCE=1000
KELLY_K=0.25
BUDGET_FRAC=0.02        # max fraction of bankroll per market
AGG_CAP=0.25            # max aggregate open exposure

# ── Settlement + seeding ─────────────────────────────────
SETTLE_GRACE_DAYS=3
OBS_BACKFILL_PER_SCAN=12
SEED_DAYS=45
SEED_ON_BOOT=true       # calibrate from the archives on first boot

# ── Backtest ─────────────────────────────────────────────
BACKTEST_DAYS=60
BACKTEST_MIN_BASKETS=40
