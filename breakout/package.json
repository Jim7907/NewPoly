{
  "name": "breakout-backtester",
  "version": "1.0.0",
  "private": true,
  "description": "Range-breakout strategy with a visual backtester — consolidation boxes, entry/stop/target ladders and a live stats panel drawn on a candlestick chart",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "local": "npm run build && npm start",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.0"
  }
}
