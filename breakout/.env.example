# Breakout backtester — all optional, sensible defaults in server/config.js
PORT=3003
# Where fetched candles are cached (defaults to breakout/data)
CACHE_DIR=
# How long a cached candle set stays fresh, in ms
CACHE_TTL_MS=300000
# Hard cap on bars per request
MAX_BARS=3000
# Fall back to generated demo data when Coinbase is unreachable
ALLOW_SYNTHETIC=true
