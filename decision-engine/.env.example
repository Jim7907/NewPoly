# ── Server ───────────────────────────────────────────────
PORT=3003
NODE_ENV=development
DB_PATH=./data

# ── Universe ─────────────────────────────────────────────
CRYPTO=BTC,ETH,SOL,XRP,DOGE          # any of BTC,ETH,SOL,XRP,DOGE,AVAX,LINK
STOCKS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY,QQQ   # any US ticker

# ── Real-time loop ───────────────────────────────────────
CRYPTO_SCAN_MS=15000
STOCK_SCAN_MS=60000

# ── Decision horizon: intraday (15m bars, 2h) | swing (daily, 5d) | position (daily, 20d)
HORIZON=swing

# ── Confidence gating (engine abstains = HOLD unless all clear) ──
MIN_CONFIDENCE=0.65
MIN_PROB_EDGE=0.06
MIN_AGREEMENT=0.55
STRONG_CONFIDENCE=0.80

# ── Paper portfolio / risk ───────────────────────────────
PAPER_BALANCE=100000
KELLY_K=0.25
MAX_POS_FRAC=0.10
MAX_GROSS=1.0
TARGET_VOL=0.15
MAX_DRAWDOWN=0.15
STOP_ATR=2.0
TARGET_ATR=3.0
FEE_BPS_CRYPTO=10
FEE_BPS_STOCK=1
SLIPPAGE_BPS=5

# ── Optional: Claude analyst (reads news + fundamentals + macro, adds one signal + narrative)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_TTL_MS=3600000

# ── Data providers ───────────────────────────────────────
SEC_USER_AGENT=decision-engine research you@example.com
WARM_START=true
