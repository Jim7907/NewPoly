{
  "name": "decision-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time AI decision engine for stocks + crypto — technical, fundamental, sentiment, macro, regime and ML signals fused into calibrated, confidence-gated decisions (paper trading only)",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "backtest": "node server/learning/backtest.js",
    "analyze": "node server/cli.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sql.js": "^1.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.0"
  }
}
