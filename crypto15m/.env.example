# ── Server ───────────────────────────────────────────────
PORT=3002
NODE_ENV=development
DB_PATH=./data

# ── Universe ─────────────────────────────────────────────
ASSETS=BTC,ETH,SOL,XRP,DOGE

# ── Scan loop ────────────────────────────────────────────
SCAN_MS=5000

# ── Strategy: lead-only by default (drift OFF) ───────────
DRIFT_ENABLED=false
MIN_EDGE=0.10          # min raw edge (P_used - entry price)
MIN_P=0.80             # only trade favorites
MIN_Z=0.8              # min |lead z-score|
LATE_WINDOW_S=360      # Mode A active when <= this many seconds remain
NO_TAKER_LAST_S=60     # no new taker entries inside final N seconds
BASIS_BPS=3            # oracle basis buffer (bps) added to lead threshold
MODE_B=false           # early/mid imbalance-momentum mode

# ── Costs ────────────────────────────────────────────────
TAKER_FEE_K=0.036      # effective taker fee = TAKER_FEE_K*(1-p) per share (~1.8% at p=0.5)
SLIP=0.005             # half-spread slippage buffer (probability units)

# ── Sizing ───────────────────────────────────────────────
PAPER_BALANCE=1000
KELLY_K=0.15
F_MAX=0.04             # max fraction of bankroll per trade
AGG_CAP=0.12           # max aggregate concurrent exposure (correlated assets)

# ── Drift weights (inert while DRIFT_ENABLED=false) ──────
W_OFI=0.15
W_CVD=0.10
W_OBI=0.05
W_MOM=0.05

# ── Liquidity gates (skip when book too wide/thin) ───────
MAX_SPREAD_C=4         # max Up-token spread in cents
MIN_DEPTH_USD=50       # min resting depth within 3c on the side we buy

# ── Backtest auto-tune ───────────────────────────────────
BACKTEST_TARGET_WR=0.80
BACKTEST_MIN_TRADES=50
